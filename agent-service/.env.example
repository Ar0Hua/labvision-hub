# 仅配置模板；服务接入完成后启用
JAVA_BASE_URL=http://127.0.0.1:8123/api
AGENT_INTERNAL_SECRET=
# 兼容旧变量 AGENT_SERVICE_SECRET；新部署统一使用上面的变量名
JAVA_REQUEST_TIMEOUT_SECONDS=10
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型标识在真实接入时根据账号可用模型配置
AGENT_CHAT_MODEL=qwen-plus
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AGENT_IMAGE_EMBEDDING_MODEL=multimodal-embedding-v1
AGENT_IMAGE_EMBEDDING_DIMENSIONS=1024
AGENT_CAPTION_MODEL=qwen-vl-plus
AGENT_FEATURE_VERSION=image-v1+text-v1+caption-v1
AGENT_VISION_MODEL=qwen3-vl-plus
AGENT_MAX_VISION_PICTURES=4
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=labvision_picture_v1
QDRANT_TIMEOUT_SECONDS=5
AGENT_MAX_STEPS=6
# Read-only MVP supports at most 20 selected assets (server-enforced, not a runtime override).
AGENT_TASK_TIMEOUT_SECONDS=120
AGENT_CHECKPOINT_REDIS_URL=redis://127.0.0.1:6379/1
AGENT_CHECKPOINT_TTL_MINUTES=1440
AGENT_MAX_INPUT_TOKENS=262144
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_TOOL_CALLS=100
AGENT_IMAGE_TOKEN_RESERVATION=8192
# 0 disables currency cap; set a positive cap and all model prices in one currency.
# Prices must be supplied by the operator, not inferred from example values.
AGENT_MAX_TASK_COST=0
AGENT_MODEL_PRICES_JSON={}
# Approved model hosts only; add a regional/private provider only after explicit data approval.
AGENT_MODEL_ALLOWED_HOSTS=dashscope.aliyuncs.com
